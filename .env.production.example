# Copy to .env.production on the deployment server. Never commit the real file.
APP_ENV=production
SEED_DEMO_DATA=false
APP_SECRET=
BIOMETRIC_ENCRYPTION_KEY=
MFA_ENCRYPTION_KEY=

MYSQL_DATABASE=ours_classroom
MYSQL_USER=ours_app
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# URL-encode special characters in the Redis password when constructing REDIS_URL.
# Use unique high-entropy secrets and protect this file with restrictive permissions.
REDIS_PASSWORD=
DATABASE_URL=

PUBLIC_DOMAINS=
ACME_EMAIL=
FRONTEND_BASE_URL=
CORS_ORIGINS=
TRUSTED_HOSTS=
SHARED_PORTAL_HOSTS=
NEXT_PUBLIC_API_URL=
SESSION_COOKIE_NAME=ours_session
ACCESS_TOKEN_MINUTES=480
API_WORKERS=1
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
FORWARDED_ALLOW_IPS=172.16.0.0/12
ALLOW_MODEL_DOWNLOADS=false

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
OBJECT_STORAGE_BUCKET=ours-private

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
REQUIRE_SMTP_IN_PRODUCTION=true

# Public Firebase web app configuration; never put service-account keys here.
FIREBASE_WEB_CONFIG={}
FIREBASE_VAPID_KEY=

CAMPUS_TIMEZONE=Asia/Kolkata
CAMERA_STREAMS_JSON=[]
CAMERA_FRAME_INTERVAL_SECONDS=2
CAMERA_HEALTH_TIMEOUT_SECONDS=20
CAMERA_RECONNECT_SECONDS=3
ATTENDANCE_FINALIZE_GRACE_SECONDS=30
ATTENDANCE_PRESENCE_GAP_SECONDS=600
ATTENDANCE_IDENTITY_GRACE_SECONDS=30
BEHAVIOUR_DATASET_VERSION=classroom-v1
BEHAVIOUR_MIN_GROUPS_PER_CLASS=3
BEHAVIOUR_MIN_SAMPLES_PER_CLASS=20
BEHAVIOUR_TRACK_TIMEOUT_SECONDS=5
BEHAVIOUR_CLASS_THRESHOLDS_JSON={}

SMS_ENABLED=false
WHATSAPP_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

PAYMENT_PROVIDER=disabled
PAYMENT_CURRENCY=INR
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=
FCM_SERVICE_ACCOUNT_JSON=
