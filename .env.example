# Local VS Code/desktop defaults. Copy this file to .env.
APP_ENV=development
APP_SECRET=replace_with_a_new_random_secret
SEED_DEMO_DATA=false
DATABASE_URL=sqlite:///./data/smart_classroom_v2.db
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
SHARED_PORTAL_HOSTS=localhost,127.0.0.1,testserver
# API calls use the same browser origin and the local Vite proxy. Keep this empty.
NEXT_PUBLIC_API_URL=
FRONTEND_BASE_URL=http://localhost:5173
FACE_MATCH_THRESHOLD=0.38
FACE_DUPLICATE_THRESHOLD=0.32
FACE_ENROLLMENT_SAMPLES=3
FACE_MIN_SIZE_PIXELS=80
FACE_MIN_BLUR_VARIANCE=45
FACE_MIN_BRIGHTNESS=35
FACE_MAX_BRIGHTNESS=225
BEHAVIOUR_CONFIDENCE_THRESHOLD=0.60
BEHAVIOUR_SMOOTHING_FRAMES=6
BEHAVIOUR_EPISODE_THRESHOLD_SECONDS=60
BEHAVIOUR_DATASET_VERSION=classroom-v1
BEHAVIOUR_MIN_GROUPS_PER_CLASS=3
BEHAVIOUR_MIN_SAMPLES_PER_CLASS=20
BEHAVIOUR_TRACK_TIMEOUT_SECONDS=5
# Optional JSON overrides, for example: {"sleeping":0.72,"fighting":0.85}
BEHAVIOUR_CLASS_THRESHOLDS_JSON={}
MAX_UPLOAD_MB=25
ASSIGNMENT_MAX_FILES=5

# Recommended on Windows: double-click configure_mysql_windows.bat.
# Manual MySQL example (create this database/user first):
# DATABASE_URL=mysql+pymysql://ours_app:your-password@127.0.0.1:3306/ours_classroom?charset=utf8mb4

# Required for production. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# BIOMETRIC_ENCRYPTION_KEY=

# Optional but required for the Forgot password email link:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=your-smtp-user
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM_EMAIL=no-reply@yourdomain.com
# SMTP_USE_TLS=true

# Optional attendance messages. Use an approved provider, verified numbers,
# approved WhatsApp templates and explicit student/guardian consent.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# SMS_ENABLED=false
# WHATSAPP_ENABLED=false

# Optional always-on CCTV/mobile/IP-camera worker. The value is JSON.
# CAMERA_STREAMS_JSON=[{"institution_slug":"your-college","classroom":"CSE-A","source":"rtsp://user:password@camera/stream"}]
# CAMERA_FRAME_INTERVAL_SECONDS=2
# CAMERA_HEALTH_TIMEOUT_SECONDS=20
# CAMERA_RECONNECT_SECONDS=3
# ATTENDANCE_FINALIZE_GRACE_SECONDS=30
# ATTENDANCE_PRESENCE_GAP_SECONDS=600
# ATTENDANCE_IDENTITY_GRACE_SECONDS=30
# CAMPUS_TIMEZONE=Asia/Kolkata

# Optional hosted fee payment. Never put card/UPI secrets in this application.
# PAYMENT_PROVIDER=razorpay
# PAYMENT_CURRENCY=INR
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Optional Firebase Cloud Messaging service account (server-side only).
# FCM_PROJECT_ID=
# FCM_SERVICE_ACCOUNT_FILE=
# FCM_SERVICE_ACCOUNT_JSON=

# Production safety switches:
# APP_ENV=production
# SEED_DEMO_DATA=false
# API_WORKERS=2
# FORWARDED_ALLOW_IPS=127.0.0.1
# ALLOW_MODEL_DOWNLOADS=false
# REQUIRE_SMTP_IN_PRODUCTION=true
# TRUSTED_HOSTS=portal.example.com,*.ours.example.com,college-owned.example.edu
# SHARED_PORTAL_HOSTS=portal.example.com
# CORS_ORIGINS=https://portal.example.com
# FRONTEND_BASE_URL=https://portal.example.com
# NEXT_PUBLIC_API_URL=
