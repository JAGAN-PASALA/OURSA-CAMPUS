# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.production.example
/backend/data/
/backend/models/*.onnx
/backend/models/*.pt
/backend/models/*.joblib
/backend/__pycache__/
*.pyc

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/.sites-runtime/
/outputs/
/work/
mobile/dist/
android/.gradle/
android/local.properties
android/app/build/
android/app/google-services.json
ios/App/App/GoogleService-Info.plist
*.keystore
*.jks

# Python environments and caches
/.venv/
/venv/
**/__pycache__/
*.py[cod]
.pytest_cache/

# Local databases and backups
*.sqlite3
*.db
*.sql.gz
/backups/

# Logs
*.log

database-backup/
